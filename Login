<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <title>Retro Gaming - Accedi</title>

    <link rel="stylesheet" href="style.css">

</head>
<body>

    <h1>RetroGaming.it</h1>

    <div class="form-container">
        <!-- Messaggio di errore dinamico (inizialmente nascosto o gestito via PHP/JavaScript) -->
        <div id="messaggio-errore" style="color: #ff4d4d; font-size: 14px; margin-bottom: 15px; text-align: center; display: none;">
            Email o password errati!
        </div>

        <form action="Login.php" method="POST">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="nome@esempio.com" required>

            <label for="password">Password</label>
            <input type="password" id="password" name="password" placeholder="********" required>

            <button type="submit">Accedi</button>
        </form>
    </div>

    <div class="link-container">
        <a href="Registrazione.html">Non hai un account? Registrati</a>
    </div>

    <!-- SCRIPT JS PER MOSTRARE L'ERRORE SE PRESENTE NELL'URL -->
    <script>
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('errore')) {
            document.getElementById('messaggio-errore').style.display = 'block';
        }
    </script>

</body>

</body>
</html>